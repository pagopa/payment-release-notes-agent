# ── GitHub ────────────────────────────────────────────────────────────────────
# Classic PAT — used only for the GitHub REST API (PR data, CODEOWNERS).
GITHUB_TOKEN=ghp_...

# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=copilot_sdk

# Fine-grained PAT with the "Copilot Requests" ACCOUNT permission.
COPILOT_GITHUB_TOKEN=github_pat_...

# Model the Copilot agent should use, unprefixed.
COPILOT_MODEL=claude-sonnet-5

# Set to 1 to allow falling back to the interactive `copilot` login stored on
# this machine when COPILOT_GITHUB_TOKEN is unset. Local convenience only —
# never set it in a container, where no such login exists.
#COPILOT_ALLOW_MACHINE_LOGIN=1

# ── Atlassian — optional (shared credentials for JIRA and Confluence) ─────────
#Get your API token at: id.atlassian.com → Security → API tokens
ATLASSIAN_URL=https://your-org.atlassian.net
ATLASSIAN_USER=your_email@company.com
ATLASSIAN_TOKEN=your_atlassian_api_token

# ── Document generation ───────────────────────────────────────────────────────
ENVIRONMENTS=prod
DOCUMENT_LANGUAGE=Italian
DEPARTMENT_NAME=Payments Department

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Dump every raw LLM response plus its parse outcome under this directory.
# Leave unset in production.
#LLM_RAW_DUMP_DIR=./spike-out

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
